<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base Application Theme -->
    <style name="Theme.FlowLauncher" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Home Screen Theme (transparent, immersive) -->
    <style name="Theme.FlowLauncher.Home" parent="Theme.FlowLauncher">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- Settings Theme (opaque, standard) -->
    <style name="Theme.FlowLauncher.Settings" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/settings_background</item>
        <item name="android:statusBarColor">@color/settings_background</item>
        <item name="android:navigationBarColor">@color/settings_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- Text Appearances -->
    <style name="TextAppearance.FlowLauncher.AppName" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:shadowColor">#80000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">4</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TextAppearance.FlowLauncher.Search" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/search_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColorHint">@color/search_hint</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="TextAppearance.FlowLauncher.GlanceTime" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textColor">@color/glance_text</item>
        <item name="android:textSize">48sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>

    <style name="TextAppearance.FlowLauncher.GlanceDate" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/glance_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
