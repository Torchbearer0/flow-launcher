<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/settings_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/settings_background"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/settings"
        app:titleTextColor="@color/settings_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Appearance Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/appearance"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/settingTheme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/theme"
                        android:textColor="@color/settings_title"
                        android:textSize="16sp"
                        android:paddingVertical="12dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_chevron_right" />

                    <TextView
                        android:id="@+id/settingWallpaper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wallpaper"
                        android:textColor="@color/settings_title"
                        android:textSize="16sp"
                        android:paddingVertical="12dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_chevron_right" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_light" />

                    <!-- Text Size -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Text Size"
                        android:textColor="@color/settings_subtitle"
                        android:textSize="14sp"
                        android:layout_marginTop="12dp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/textSizeSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0.8"
                        android:valueTo="1.4"
                        android:stepSize="0.1"
                        android:value="1.0" />

                    <!-- Icon Size -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Icon Size"
                        android:textColor="@color/settings_subtitle"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/iconSizeSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0.7"
                        android:valueTo="1.5"
                        android:stepSize="0.1"
                        android:value="1.0" />

                    <!-- Item Spacing -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Item Spacing"
                        android:textColor="@color/settings_subtitle"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/spacingSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0.6"
                        android:valueTo="1.8"
                        android:stepSize="0.1"
                        android:value="1.0" />

                    <!-- Background Opacity -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Background Opacity"
                        android:textColor="@color/settings_subtitle"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/opacitySlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0.0"
                        android:valueTo="1.0"
                        android:stepSize="0.05"
                        android:value="0.7" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- At A Glance Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/at_a_glance"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Show At A Glance"
                            android:textColor="@color/settings_title"
                            android:textSize="16sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchAtAGlance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/notification_dots"
                            android:textColor="@color/settings_title"
                            android:textSize="16sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchNotificationDots"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Alphabet Scrollbar"
                            android:textColor="@color/settings_title"
                            android:textSize="16sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchAlphabetScroll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Auto Hide Status Bar"
                            android:textColor="@color/settings_title"
                            android:textSize="16sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchHideStatusBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Behavior Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/behavior"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/settingNotifications"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/notification_listener"
                        android:textColor="@color/settings_title"
                        android:textSize="16sp"
                        android:paddingVertical="12dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_chevron_right" />

                    <TextView
                        android:id="@+id/settingAccessibility"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lock_screen_service"
                        android:textColor="@color/settings_title"
                        android:textSize="16sp"
                        android:paddingVertical="12dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_chevron_right" />

                    <TextView
                        android:id="@+id/settingDefaultLauncher"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Default Launcher"
                        android:textColor="@color/settings_title"
                        android:textSize="16sp"
                        android:paddingVertical="12dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_chevron_right" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Gestures Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gestures"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/settingDoubleTap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/gesture_double_tap"
                        android:textColor="@color/settings_title"
                        android:textSize="16sp"
                        android:paddingVertical="12dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_chevron_right" />

                    <TextView
                        android:id="@+id/settingSwipeUp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/gesture_swipe_up"
                        android:textColor="@color/settings_title"
                        android:textSize="16sp"
                        android:paddingVertical="12dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_chevron_right" />

                    <TextView
                        android:id="@+id/settingSwipeDown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/gesture_swipe_down"
                        android:textColor="@color/settings_title"
                        android:textSize="16sp"
                        android:paddingVertical="12dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_chevron_right" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- About Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/settingVersion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Version 1.0.0"
                        android:textColor="@color/settings_title"
                        android:textSize="16sp"
                        android:paddingVertical="12dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
